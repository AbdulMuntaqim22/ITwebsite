# Server
PORT=3001
DATABASE_PATH=./data/mza.db
NODE_ENV=development

# Admin login (change before production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=use-a-long-random-string-here

# Dev: Vite runs on 5173, API on 3001 (proxy handles /api)
CORS_ORIGIN=http://localhost:5173

# Frontend (optional — leave empty when API serves the site on same host)
# VITE_API_URL=http://localhost:3001
